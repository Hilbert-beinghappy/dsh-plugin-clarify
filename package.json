{
  "name": "dsh-plugin-clarify",
  "version": "0.2.2",
  "description": "Off-transcript clarification Host plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshPlugin": {
    "testedHost": "0.1.1-rc.2",
    "testedHosts": [
      "0.1.0-rc.8",
      "0.1.1-rc.2"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "pnpm pack",
    "pack:check": "node scripts/pack-check.mjs",
    "t0": "node scripts/t0-run.mjs",
    "t0:rc6": "node scripts/t0-run.mjs --dsh-version 0.1.0-rc.6",
    "t0:rc7": "node scripts/t0-run.mjs --dsh-version 0.1.0-rc.7",
    "t0:rc8": "node scripts/t0-run.mjs --dsh-version 0.1.0-rc.8",
    "t0:dsh011rc1": "node scripts/t0-run.mjs --dsh-version 0.1.1-rc.1",
    "t1:dsh011rc1": "node scripts/t1-lifecycle.mjs --dsh-version 0.1.1-rc.1",
    "t0:dsh011rc2": "node scripts/t0-run.mjs --dsh-version 0.1.1-rc.2",
    "t1:dsh011rc2": "node scripts/t1-lifecycle.mjs --dsh-version 0.1.1-rc.2",
    "t0:latest": "node scripts/t0-run.mjs --dsh-tag latest",
    "t0:next": "node scripts/t0-run.mjs --dsh-tag next",
    "t0:matrix": "node scripts/t0-matrix.mjs",
    "t1": "node scripts/t1-lifecycle.mjs",
    "t1:matrix": "node scripts/t0-matrix.mjs t1",
    "t3": "node scripts/t3-e2e.mjs",
    "t7": "node scripts/t7-lab.mjs",
    "t7:validate": "node scripts/t7-lab.mjs --validate",
    "t7:from-pack": "node scripts/t7-lab.mjs --from-pack",
    "t7:from-release": "node scripts/t7-lab.mjs --from-release --require-local-assets --clarify-release 0.2.2 --auxiliary-release 0.1.1",
    "sanitize:appledouble": "node scripts/remove-appledouble.mjs",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "host-plugin",
    "clarify"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
